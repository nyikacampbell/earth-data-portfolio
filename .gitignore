#### STANDARD IGNORED FILES ####

# History files
.Rhistory
.Rapp.history

# Session Data files
.RData
.RDataTmp

# Default graphics device output (spawned when print()/plot() runs with no device)
Rplots.pdf

# User-specific files
.Ruserdata

# Example code in package build process
*-Ex.R

# Output files from R CMD build
/*.tar.gz

# Output files from R CMD check
/*.Rcheck/

# RStudio files
.Rproj.user/

# produced vignettes
vignettes/*.html
vignettes/*.pdf

# OAuth2 token, see https://github.com/hadley/httr/releases/tag/v0.3
.httr-oauth

# knitr and R markdown default cache directories
*_cache/
/cache/

# rosm/ggspatial OSM tile cache -- lands wherever the working directory was
# when annotation_map_tile() ran, so ignore it anywhere rather than just at
# the one location it's currently in
rosm.cache/

# Temporary files created by R markdown
*.utf8.md
*.knit.md

# R Environment Variables
.Renviron

# pkgdown site
docs/

# translation temp files
po/*~

# RStudio Connect folder
rsconnect/
.positai

#Add DS_Store files to gitignore 
.DS_Store

#add R project files
.Rproj

# R Markdown render logs
*.log

#### OPTIONAL SETTINGS FOR LARGE FILES ####

# Microsoft Office partial files
~$*.pptx
~$*.xlsx
~$*.docx

# Spatial data file types
## Shapefile components
*.shp
*.shx
*.sbn
*.sbx
*.shp.xml
*.shx.xml
*.prj
*.dbf
*.cpg

## Non-shapefile spatial data
*.nc
*.tif
*.geojson

### Turn on and off with comments

# Image file types
#*.png
#*.jpeg
#*.jpg

# Other file types
#*.pdf
#*.zip
#*.rds
#*.rdata

# Data file types
## Delete the hashtag (on the left in the following lines) if you _would_ like to ignore this file type
# *.csv 
# *.xlsx 
# *.xls 
# *.txt

# Folders to ignore
## Add any folders you’d like to ignore below (with or without the trailing slash)
# graphs/

#### REPO_SPECIFIC IGNORES ####
# any data or output folders in any subdirectory at any level
data/
output/
outputs/
input/
inputs/

# Any folder containing 'scratch' including names that end with 'scratch' (case insensitive)
*scratch/


